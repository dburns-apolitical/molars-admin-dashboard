# URL of your post-for-me backend server.
# Local dev: leave unset, defaults to http://localhost:3001.
# Production: required. Example: https://your-app.ondigitalocean.app
VITE_API_BASE_URL=

# Neon Auth endpoint for email OTP sign-in.
# Get this from your Neon project: Auth > Settings > Auth URL.
VITE_NEON_AUTH_URL=
